      ],
      "id": "35262bd0-214b-49f7-a8bc-b1b3895469b7",
      "name": "Classificar e-mail - DeepSeek",
      "credentials": {
        "httpHeaderAuth": {
          "id": "KafeN8swMq6rpuwp",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst resposta = $input.first().json;\n\nconst conteudo = resposta.choices[0].message.content;\n\nlet classificacao;\n\ntry {\n  classificacao = JSON.parse(conteudo);\n} catch (error) {\n  throw new Error(\n    \"A IA retornou um JSON inválido: \" + error.message\n  );\n}\n\nconst categorias = [\n  \"cobranca\",\n  \"suporte_tecnico\",\n  \"duvida_produto\",\n  \"cancelamento\",\n  \"entrega_pedido\",\n  \"elogio\",\n  \"outros\"\n];\n\nconst urgencias = [\"alta\", \"media\", \"baixa\"];\n\nconst sentimentos = [\"positivo\", \"neutro\", \"negativo\"];\n\nif (!categorias.includes(classificacao.categoria)) {\n  throw new Error(\"Categoria inválida.\");\n}\n\nif (!urgencias.includes(classificacao.urgencia)) {\n  throw new Error(\"Urgência inválida.\");\n}\n\nif (!sentimentos.includes(classificacao.sentimento)) {\n  throw new Error(\"Sentimento inválido.\");\n}\n\nconst dadosOriginais = $(\"Cobrança Duplicada\").first().json;\n\nreturn [\n  {\n    json: {\n      ...dadosOriginais,\n      ...classificacao\n    }\n  }\n];"
      },
